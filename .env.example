# Copy this file to `.env` and fill in the values from your Mind Record
# Supabase project — Project Settings → Data API (URL) and → API Keys
# (Publishable key). Never put the service_role key or the database
# password here; this file is bundled into the client app.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — do not
# put anything secret in a variable with this prefix.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In (native) — the same "Web application" OAuth Client ID
# already registered with Supabase's Google provider (Authentication →
# Providers → Google). Client IDs aren't secret; this is what Google's ID
# token is issued for (its `aud` claim), which is what Supabase verifies.
# A separate "Android" OAuth Client (package name + SHA-1 fingerprint, no
# code-facing value) also has to exist in the same Google Cloud project —
# see the deployment checklist for exact steps.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In on iOS specifically — a THIRD, separate OAuth Client of
# type "iOS" (matching this app's bundle id, com.liflux.mindrecord), on top
# of the Web and Android ones above. Until this is set, "Continue with
# Google" only works on Android. Once you have it, also add its reversed
# form to app.json's plugins array:
#   ["@react-native-google-signin/google-signin", { "iosUrlScheme": "com.googleusercontent.apps.<the-client-id-prefix-before-.apps.googleusercontent.com>" }]
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
